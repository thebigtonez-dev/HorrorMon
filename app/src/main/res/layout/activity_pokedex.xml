<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d0d0d"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pokedex"
        android:textSize="24sp"
        android:textColor="#ff0000"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="8dp">

            <Button
                android:id="@+id/filterAllButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:backgroundTint="#333333" />

            <Button
                android:id="@+id/filterShadowButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shadow"
                android:backgroundTint="#333333" />

            <Button
                android:id="@+id/filterNightmareButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nightmare"
                android:backgroundTint="#333333" />

            <Button
                android:id="@+id/filterRareButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rare"
                android:backgroundTint="#cc00cc" />

        </LinearLayout>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pokedexRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

</LinearLayout>
